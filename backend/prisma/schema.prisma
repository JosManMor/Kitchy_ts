generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  CHEF
}

enum RecipeReactionType {
  LIKE
  BOOKMARK
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  recipes    Recipe[]

  @@map("categories")
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  icon      String?
  code      String?  @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipes   Recipe[]

  @@map("countries")
}

model Ingredient {
  id                Int                @id @default(autoincrement())
  name              String             @unique @db.VarChar(100)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")

  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}

model Unit {
  id                Int                @id @default(autoincrement())
  name              String             @unique @db.VarChar(50)
  type              String             @db.VarChar(50)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  recipeIngredients RecipeIngredient[]

  @@map("units")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username       String    @unique @db.VarChar(100)
  email          String    @unique @db.VarChar(100)
  password       String
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  recipes        Recipe[]
  reactions      UserRecipeReaction[]

  @@map("users")
}

model Recipe {
  id                 Int              @id @default(autoincrement())
  authorId           String           @map("author_id") @db.Uuid
  title              String           @db.VarChar(150)
  slug               String           @unique @db.VarChar(180)
  description        String?
  imageUrl           String?          @map("image_url")
  preparationMinutes Int              @map("preparation_minutes")
  servings           Int
  difficulty         RecipeDifficulty
  categoryId         Int?             @map("category_id")
  countryId          Int?             @map("country_id")

  likesCount         Int              @default(0) @map("likes_count")
  bookmarksCount     Int              @default(0) @map("bookmarks_count")
  viewsCount         Int              @default(0) @map("views_count")

  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  author             User             @relation(fields: [authorId], references: [id], onDelete: Restrict, map: "fk_recipe_author")
  category           Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_recipe_category")
  country            Country?         @relation(fields: [countryId], references: [id], onDelete: SetNull, map: "fk_recipe_country")

  recipeIngredients  RecipeIngredient[]
  steps              RecipeStep[]
  reactions          UserRecipeReaction[]

  @@index([title])
  @@map("recipes")
}

model RecipeStep {
  id          Int      @id @default(autoincrement())
  recipeId    Int      @map("recipe_id")
  stepNumber  Int      @map("step_number")
  instruction String
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict, map: "fk_recipe_step_recipe")

  @@unique([recipeId, stepNumber])
  @@map("recipe_steps")
}

model RecipeIngredient {
  recipeId      Int      @map("recipe_id")
  ingredientId  Int      @map("ingredient_id")
  unitId        Int?     @map("unit_id")
  quantity      Decimal  @db.Decimal(10, 2)

  recipe        Recipe      @relation(fields: [recipeId], references: [id], onDelete: Restrict, map: "fk_recipe_ingredient_recipe")
  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict, map: "fk_recipe_ingredient_ingredient")
  unit          Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull, map: "fk_recipe_ingredient_unit")

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model UserRecipeReaction {
  id         BigInt             @id @default(autoincrement())
  userId     String             @map("user_id") @db.Uuid
  recipeId   Int                @map("recipe_id")
  type       RecipeReactionType

  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  deletedAt  DateTime?          @map("deleted_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict, map: "fk_user_recipe_reaction_user")
  recipe     Recipe             @relation(fields: [recipeId], references: [id], onDelete: Restrict, map: "fk_user_recipe_reaction_recipe")

  @@unique([userId, recipeId, type])
  @@map("user_recipe_reactions")
}